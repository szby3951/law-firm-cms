# 复制为 .env 后按本机环境填写
# cp .env.example .env

# ===== 应用 =====
APP_NAME=律所客户智能管理系统
APP_ENV=dev
DEBUG=true
API_PREFIX=/api
LOG_LEVEL=INFO

# ===== 数据库（MySQL 8，utf8mb4）=====
DATABASE_URL=mysql+aiomysql://root:your_password@127.0.0.1:3306/law_firm?charset=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ===== JWT =====
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=please-generate-your-own-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 出站网络 =====
# 访问大模型 / TEI / Qdrant 的 HTTP 代理，留空表示直连。
# 留空时**不读取** HTTP_PROXY、HTTPS_PROXY 等环境变量：后端由终端或 IDE
# 拉起时会继承临时代理，代理一停，AI 调用全部超时，且报错指向 httpx 的
# http_proxy，很难定位。确实需要代理时填这里，例如 http://127.0.0.1:7890
OUTBOUND_PROXY=

# ===== Qdrant 向量库 =====
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=law_kb

# ===== 云端大模型（OpenAI 兼容 API）=====
# 三种常见填法（换供应商只改这四项，业务代码零改动）：
#   阿里云百炼：LLM_PROVIDER=qwen     LLM_MODEL=qwen3.8-max
#               LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek  ：LLM_PROVIDER=deepseek LLM_MODEL=deepseek-chat
#               LLM_BASE_URL=https://api.deepseek.com/v1
#   本地 mock ：LLM_PROVIDER=openai   LLM_MODEL=mock
#               LLM_BASE_URL=http://127.0.0.1:8099/v1  LLM_API_KEY=test-key
LLM_PROVIDER=qwen
LLM_MODEL=qwen3.8-max
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.3
# 单次回复的 token 上限
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
# 混合思考模型（qwen3 系列等）的思维链开关：auto=用默认 / on=开 / off=关。
# 关闭后不再先输出思考过程，首字更快、不额外消耗 token。
# DeepSeek 等不认该字段的供应商请填 auto，否则请求会 400。
LLM_ENABLE_THINKING=off

# ===== Embedding（本地 TEI 服务，OpenAI 兼容 /embed）=====
# 容器：docker run -p 8081:80 ... /models/bge-large-zh-v1.5
# 换模型必须同步改 EMBEDDING_DIM，否则 Qdrant collection 维度不匹配
EMBEDDING_MODEL=bge-large-zh-v1.5
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=http://127.0.0.1:8081
EMBEDDING_BATCH_SIZE=8
# TEI 单条上限 512 token（中文约 1 字≈1 token），留余量取 460
EMBEDDING_MAX_CHARS=460
# CPU 推理串行，并发过高只会在服务端排队
EMBEDDING_CONCURRENCY=3
EMBEDDING_TIMEOUT=180

# ===== RAG 问答（9.3）=====
FIRM_NAME=示例律师事务所
# 每次检索带入的条文/知识条数（设计文档要求 5~8）
RAG_TOP_K=6
# 余弦相似度下限，低于该值不送入提示词
RAG_MIN_SCORE=0.35
RAG_REF_MAX_CHARS=900
RAG_MAX_CONTEXT_CHARS=5200
# 多轮对话携带的历史消息条数与单条截断长度
AI_HISTORY_MESSAGES=6
AI_HISTORY_MAX_CHARS=1200

# ===== 合同风险审查（9.5）=====
# 单批送审条款字符数（6000 字约合 4.5k token，单批约 20~40 秒）
CONTRACT_REVIEW_BATCH_CHARS=6000
# 单份合同送审字符上限，超出只审前部并在报告中标注
CONTRACT_REVIEW_MAX_CHARS=60000
# 最多分几批
CONTRACT_REVIEW_MAX_BATCHES=8
# 单批输出的 token 上限（审查结果是结构化风险列表，2048 会被截断）
CONTRACT_REVIEW_MAX_TOKENS=4096

# ===== 案件摘要（9.6）=====
# 单份材料送入提示词的字数上限（超出取前部并标注「已节选」）
CASE_SUMMARY_ITEM_CHARS=6000
# 全部材料的总字数上限
CASE_SUMMARY_TOTAL_CHARS=24000
# 最多纳入几份材料，其余列入「未纳入材料」提示缺口
CASE_SUMMARY_MAX_MATERIALS=20
# 摘要输出 token 上限（六节结构约 2~3k 字）
CASE_SUMMARY_MAX_TOKENS=3000

# ===== 客户画像（9.7）=====
# 最近几条跟进进提示词（旧记录会淹没「最近一次说了什么」）
CLIENT_PROFILE_MAX_FOLLOWS=8
# 单条跟进正文上限
CLIENT_PROFILE_FOLLOW_CHARS=300
# 关联案件 / 合同 / 收费方案各取最近几项
CLIENT_PROFILE_MAX_CASES=10
CLIENT_PROFILE_MAX_CONTRACTS=6
CLIENT_PROFILE_MAX_FEE_PLANS=6
# 沟通留言条数与单条上限
CLIENT_PROFILE_MAX_MESSAGES=12
CLIENT_PROFILE_MESSAGE_CHARS=150
# 全部输入的总字数上限，超出从信息密度最低的一类开始裁
CLIENT_PROFILE_MAX_CHARS=8000
# 画像输出 token 上限（8 个字段约 800~1200 字）
CLIENT_PROFILE_MAX_TOKENS=1500

# ===== 文件上传 =====
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=20971520

# ===== CORS（逗号分隔）=====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 定时任务（提醒扫描）=====
# 关闭后不再自动扫描，仅能通过 POST /api/notifications/scan 手动触发
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=5
REMIND_AHEAD_DAYS=3
CONTRACT_EXPIRY_DAYS=30
