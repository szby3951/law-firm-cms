# ============================================================================
# 生产环境配置模板（Linux 服务器）
#
# 用法：
#   cp .env.prod.example .env          # 在服务器上执行
#   vi .env                            # 逐项替换所有 CHANGE_ME
#
# 三条铁律：
#   1. 本文件是模板，填好后的副本只能留在服务器，禁止提交到代码仓库；
#   2. 所有 CHANGE_ME 都必须替换，prod_check.py 会逐项拦住；
#   3. 本文件由 config.py 的 env_file 直接读取，不需要 export。
#
# 未列出的配置项（合同审查批大小、案件摘要字数上限、客户画像取数条数等）
# 均沿用 app/config.py 中的默认值，确认无误即可不动。
# ============================================================================

# ---------- 应用 ----------
APP_NAME=律所客户智能管理系统
# 必须 prod：会关闭 /docs、/redoc、openapi.json，并收敛健康检查的报错细节
APP_ENV=prod
DEBUG=false
API_PREFIX=/api
LOG_LEVEL=INFO

# ---------- 数据库 ----------
# 不要用 root。先在 MySQL 里建专用账号：
#   CREATE USER 'lawfirm_app'@'127.0.0.1' IDENTIFIED BY '<强密码>';
#   GRANT SELECT,INSERT,UPDATE,DELETE ON law_firm.* TO 'lawfirm_app'@'127.0.0.1';
#   FLUSH PRIVILEGES;
# （只需 DML 权限；建表/改表由发布流程单独执行）
DATABASE_URL=mysql+aiomysql://lawfirm_app:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/law_firm?charset=utf8mb4
DB_ECHO=false
# 2C2G 机器同时最多 10 条连接就够（本系统并发用户通常 <20）：
# 每条连接在 MySQL 侧都要占排序/临时表缓冲，池子开大会把它撑爆。
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ---------- JWT ----------
# 必须重新生成，禁止沿用开发值：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_SECRETS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- 跨域 ----------
# 写前端实际访问的域名（含协议与端口）。前后端同源部署也建议填写，
# 避免以后拆子域时忘记改。禁止保留 localhost / 127.0.0.1。
CORS_ORIGINS=https://law.example.com

# ---------- 文件上传 ----------
# 必须是绝对路径，且位于持久化磁盘（容器部署需挂载 volume），
# 运行用户（systemd 的 User）对其有读写权限。
UPLOAD_DIR=/var/lib/law-firm/uploads
MAX_UPLOAD_SIZE=20971520

# ---------- 出站网络 ----------
# 留空 = 直连。注意代码会**主动忽略** HTTP_PROXY/HTTPS_PROXY 环境变量，
# 服务器需要代理才能出网时必须显式写在这里，否则模型调用会连接超时。
OUTBOUND_PROXY=

# ---------- 大模型（OpenAI 兼容接口）----------
LLM_PROVIDER=qwen
LLM_MODEL=qwen3.8-max
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=CHANGE_ME_LLM_API_KEY
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_ENABLE_THINKING=auto

# ---------- 向量检索（Qdrant + 云端向量化）----------
# Qdrant 需与 Web 同机部署或网络可达（约 150~250MB 内存）。未部署时 AI 模块
# 整体降级为 503，主业务（客户/案件/合同/收费/文书）不受影响。
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=law_kb
# provider=openai 走云端 /embeddings，服务器上不需要跑任何向量模型；
# 仅当机器内存 ≥4GB 且要求完全离线时，才改成 tei 并自建 TEI 容器。
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=2560
# 留空则复用 LLM_API_KEY；单独填可以隔离配额与计费
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_BATCH=10
EMBEDDING_CONCURRENCY=3
EMBEDDING_TIMEOUT=30
# 检索相似度下限，与向量模型强相关：qwen3.7 下相关命中 0.6~0.78、无关问题约 0.35，
# 故取 0.40。换模型后需用 scripts/rag_smoke.py --retrieve 重新标定。
RAG_MIN_SCORE=0.40

# ---------- 律所信息 ----------
# 会写进 AI 系统提示词（"你是XX律师事务所的法律顾问"），不要留占位值
FIRM_NAME=CHANGE_ME_律师事务所全称

# ---------- 定时任务 ----------
# 提醒扫描（开庭/缴费/跟进/合同到期）。Web 必须单 worker，否则会重复执行。
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=5
REMIND_AHEAD_DAYS=3
CONTRACT_EXPIRY_DAYS=30

# ---------- 种子账号密码（仅 scripts/create_users.py 使用）----------
# 生产环境不配置这三项，create_users.py 会直接拒绝执行。
# 要求：长度 >= 12，且不得等于开发默认值。
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SEED_LAWYER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SEED_CLIENT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
